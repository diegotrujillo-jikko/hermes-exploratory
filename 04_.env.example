# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Weights & Biases (wan.db) Configuration
WANDB_PROJECT=hermes-exploratory
WANDB_ENTITY=your_username_or_team

# Hermes Configuration
HERMES_MODEL=sonnet
HERMES_TEMPERATURE=0.2
HERMES_MAX_TOKENS=2048

# PostgreSQL Test Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hermes_test_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Environment
ENVIRONMENT=local
DEBUG=true
