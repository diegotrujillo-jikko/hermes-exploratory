# Copy this file to .env and fill in the values.
# .env is git-ignored — never commit real keys.

# Anthropic API key — used by Hermes to call Claude models (Sonnet, Opus, Haiku).
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Weights & Biases API key — used to log run metadata and rubric scores.
# Get one at: https://wandb.ai/authorize
WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# W&B project name — runs land in this project.
WANDB_PROJECT=hermes-exploratory

# W&B entity (your username or team). Leave blank to use the default.
WANDB_ENTITY=
